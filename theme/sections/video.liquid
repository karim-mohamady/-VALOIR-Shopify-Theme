<section class="valoir-video-section" style="padding: 5rem 0; background: #121214; color: #FAF9F6;" data-section-id="{{ section.id }}">
  <div class="valoir-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div style="text-align: center; max-width: 680px; margin: 0 auto 3rem auto;">
        {%- if section.settings.subheading != blank -%}
          <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 300; color: #FAF9F6; margin: 0;">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="valoir-video-player-container" style="position: relative; width: 100%; aspect-ratio: 16 / 9; max-width: 1040px; margin: 0 auto; background: #18181C; border-radius: var(--radius-sm); overflow: hidden; display: flex; align-items: center; justify-content: center; border: 1px solid #282830;">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1100x', loop: section.settings.enable_video_looping, controls: true, autoplay: false, muted: false, class: 'valoir-video-element', style: 'width: 100%; height: 100%; object-fit: cover;' }}
      {%- elsif section.settings.video_url != blank -%}
        <div class="valoir-video-embed" style="width: 100%; height: 100%;">
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.description | default: section.settings.heading | escape }}"
              style="width: 100%; height: 100%; border: none;"
            ></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.description | default: section.settings.heading | escape }}"
              style="width: 100%; height: 100%; border: none;"
            ></iframe>
          {%- endif -%}
        </div>
      {%- else -%}
        <!-- Video Cover & Onboarding Visual when no video is uploaded yet -->
        {%- if section.settings.cover_image != blank -%}
          {{ section.settings.cover_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'valoir-video-cover', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;' }}
          <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.4);"></div>
        {%- else -%}
          <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0.35;">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        <div style="position: relative; z-index: 2; text-align: center; padding: 2rem;">
          <p style="font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.12em; color: #FAF9F6; margin: 0; font-weight: 500;">
            {{ section.settings.description | default: 'Cinematography' }}
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CINEMATOGRAPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Sabae Artisanal Process"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube or Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Video Alt Text / Description",
      "default": "Bespoke Eyewear Craftsmanship in Sabae, Japan"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop Video",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
