<section class="valoir-testimonials-section" style="padding: clamp(3.5rem, 6vw, 6rem) 0; background: var(--color-bg);" data-section-id="{{ section.id }}">
  <div class="valoir-container">
    <div style="text-align: center; max-width: 640px; margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;">
      {%- if section.settings.subheading != blank -%}
        <span style="font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          {{ section.settings.subheading | escape }}
        </span>
      {%- endif -%}
      <h2 style="font-size: clamp(1.875rem, 3.2vw, 2.5rem); font-weight: 300; font-family: var(--font-serif); margin: 0 0 0.75rem 0; color: var(--color-text);">
        {{ section.settings.heading | default: "Expert Perspectives & Verified Patronage" | escape }}
      </h2>
      {%- if section.settings.description != blank -%}
        <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin: 0;">
          {{ section.settings.description | escape }}
        </p>
      {%- endif -%}
    </div>

    <div class="valoir-testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="valoir-testimonial-card" {{ block.shopify_attributes }}>
          <div>
            <!-- Rating & Verified Badge -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
              <div style="display: flex; gap: 0.25rem; color: var(--color-accent);">
                {%- for i in (1..5) -%}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                {%- endfor -%}
              </div>

              {%- if block.settings.verified != false -%}
                <span style="font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #1B7340; background: #E8F5E9; padding: 0.2rem 0.5rem; border-radius: 2px; display: inline-flex; align-items: center; gap: 0.25rem;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  Verified
                </span>
              {%- endif -%}
            </div>

            <!-- Review Quote -->
            <blockquote style="font-family: var(--font-serif); font-size: 1.0625rem; line-height: 1.65; color: var(--color-text); margin: 0 0 1.5rem 0; font-style: italic;">
              "{{ block.settings.quote | escape }}"
            </blockquote>
          </div>

          <!-- Reviewer Account Profile with Photo -->
          <div style="border-top: 1px solid var(--color-border); padding-top: 1.25rem; display: flex; align-items: center; gap: 0.875rem;">
            <div style="position: relative; width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: #ECE8E0; border: 1.5px solid var(--color-border);">
              {%- if block.settings.avatar != blank -%}
                <img
                  src="{{ block.settings.avatar | image_url: width: 120 }}"
                  alt="{{ block.settings.author | escape }}"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
              {%- else -%}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 1.125rem; color: #6B6864; font-weight: 500;">
                  {{ block.settings.author | slice: 0, 1 | upcase }}
                </div>
              {%- endif -%}
            </div>

            <div style="min-width: 0; flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;">
                <span style="font-family: var(--font-serif); font-weight: 600; font-size: 0.9375rem; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">
                  {{ block.settings.author | escape }}
                </span>
                {%- if block.settings.location != blank -%}
                  <span style="font-size: 0.6875rem; color: var(--color-text-muted); flex-shrink: 0;">
                    {{ block.settings.location | escape }}
                  </span>
                {%- endif -%}
              </div>

              {%- if block.settings.publication != blank -%}
                <span style="font-size: 0.6875rem; color: var(--color-text-muted); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.15rem;">
                  {{ block.settings.publication | escape }}
                </span>
              {%- endif -%}

              {%- if block.settings.frame_purchased != blank -%}
                <span style="font-size: 0.625rem; font-family: monospace; color: var(--color-accent); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.25rem;">
                  {{ block.settings.frame_purchased | escape }}
                </span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .valoir-testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .valoir-testimonial-card {
    background: var(--color-surface);
    padding: clamp(1.5rem, 3.5vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .valoir-testimonial-card:hover {
    border-color: rgba(194, 155, 56, 0.4);
    box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
  }
  @media (min-width: 768px) {
    .valoir-testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }
  @media (min-width: 1024px) {
    .valoir-testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CRITICAL ACCLAIM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Expert Perspectives & Verified Patronage"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Evaluated by leading optical designers, architecture critics, and verified collectors worldwide."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Customer Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Photo Avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Elena Vance"
        },
        {
          "type": "text",
          "id": "publication",
          "label": "Role or Title",
          "default": "Senior Eye Care & Architecture Critic"
        },
        {
          "type": "text",
          "id": "location",
          "label": "City / Location",
          "default": "Paris, France"
        },
        {
          "type": "text",
          "id": "frame_purchased",
          "label": "Verified Eyewear Model",
          "default": "Aero Minimalist • Pure Japanese Beta-Titanium"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Collector Status",
          "default": true
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "The titanium hinge damping is extraordinary. It feels like closing the door of a bespoke Swiss timepiece."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author": "Elena Vance",
            "publication": "Senior Eye Care & Architecture Critic",
            "location": "Paris, France",
            "frame_purchased": "Aero Minimalist • Japanese Beta-Titanium",
            "verified": true,
            "quote": "The titanium hinge damping is extraordinary. It feels like closing the door of a bespoke Swiss timepiece."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Marco Scarlatti",
            "publication": "Haute Horlogerie & Design Director",
            "location": "Milan, Italy",
            "frame_purchased": "Grand Palais • Mazzucchelli Acetate",
            "verified": true,
            "quote": "Valoir achieves an optical instrument of surgical precision that feels weightless on the nose bridge."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Kenji Takahashi",
            "publication": "Master Optometrist & Eyewear Historian",
            "location": "Tokyo, Japan",
            "frame_purchased": "Solarium Haute • Multi-Axis Titanium",
            "verified": true,
            "quote": "Their mineral polarized lenses provide crystal clarity without chromatic aberration or peripheral distortion."
          }
        }
      ]
    }
  ]
}
{% endschema %}
