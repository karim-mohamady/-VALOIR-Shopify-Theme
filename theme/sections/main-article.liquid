<article class="valoir-article-section" style="padding: 3rem 0 6rem;">
  <div class="valoir-container" style="max-width: 840px;">
    {% render 'breadcrumb' %}

    <header class="article-header" style="text-align: center; margin: 2.5rem 0 3rem;">
      <span style="font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.75rem;">
        {{ blog.title }}
      </span>
      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 300; line-height: 1.2; margin-bottom: 1.25rem;">
        {{ article.title }}
      </h1>
      <div style="font-size: 0.8125rem; color: var(--color-text-muted); display: flex; align-items: center; justify-content: center; gap: 1rem;">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: format: 'date' }}
        </time>
        {%- if article.author != blank -%}
          <span>•</span>
          <span>{{ article.author }}</span>
        {%- endif -%}
      </div>
    </header>

    {%- if article.image -%}
      <div style="margin-bottom: 3rem; border-radius: var(--radius-sm); overflow: hidden;">
        <img
          src="{{ article.image | image_url: width: 1400 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="1400"
          height="800"
          loading="eager"
          style="width: 100%; height: auto; display: block; object-fit: cover;"
        >
      </div>
    {%- endif -%}

    <div class="article-content" style="font-size: 1.0625rem; line-height: 1.85; color: #2A2A2A;">
      {{ article.content }}
    </div>

    <div style="border-top: 1px solid var(--color-border); margin-top: 4rem; padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href="{{ blog.url }}" class="btn-secondary" style="padding: 0.625rem 1.5rem; font-size: 0.75rem;">
        &larr; Back to {{ blog.title }}
      </a>
      {%- if article.tags.size > 0 -%}
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          {%- for tag in article.tags -%}
            <span style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; background: #F4F1EC; padding: 0.25rem 0.6rem; border-radius: 2px;">
              #{{ tag }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
