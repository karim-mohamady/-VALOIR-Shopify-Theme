<section class="valoir-contact-section" style="padding: 4rem 0 6rem;">
  <div class="valoir-container" style="max-width: 800px;">
    {% render 'breadcrumb' %}

    <header style="text-align: center; margin: 2rem 0 3.5rem;">
      <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
        ATELIER CONCIERGE &amp; SALON
      </span>
      <h1 style="font-family: var(--font-serif); font-size: 3rem; font-weight: 300;">
        {{ page.title | default: 'Contact Valoir' }}
      </h1>
      {%- if page.content != blank -%}
        <div style="font-size: 1rem; color: var(--color-text-muted); line-height: 1.7; margin-top: 1rem;">
          {{ page.content }}
        </div>
      {%- endif -%}
    </header>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 2.5rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <div role="status" tabindex="-1" autofocus style="background: #F0F7ED; border: 1px solid #D1E7DD; color: #0F5132; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 2rem; font-size: 0.875rem;">
            ✓ Thank you for reaching out. A Valoir optical master concierge will review your inquiry within one business day.
          </div>
        {%- elsif form.errors -%}
          <div role="alert" tabindex="-1" autofocus style="background: #FDF2F2; border: 1px solid #F8D7DA; color: #842029; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 2rem; font-size: 0.875rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
          <div>
            <label for="ContactFormName" style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.5rem;">
              Full Name
            </label>
            <input
              type="text"
              id="ContactFormName"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="e.g. Eleanor Vance"
              required
              style="width: 100%; padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem;"
            >
          </div>

          <div>
            <label for="ContactFormEmail" style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.5rem;">
              Email Address
            </label>
            <input
              type="email"
              id="ContactFormEmail"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="e.g. eleanor@example.com"
              required
              style="width: 100%; padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem;"
            >
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
          <div>
            <label for="ContactFormPhone" style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.5rem;">
              Phone (Optional)
            </label>
            <input
              type="tel"
              id="ContactFormPhone"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="+1 (555) 000-0000"
              style="width: 100%; padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem;"
            >
          </div>

          <div>
            <label for="ContactFormInquiryType" style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.5rem;">
              Inquiry Type
            </label>
            <select
              id="ContactFormInquiryType"
              name="contact[inquiry_type]"
              style="width: 100%; padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem; background: #FFF;"
            >
              <option value="Prescription & Optical Measurement">Prescription &amp; Optical Measurement</option>
              <option value="Bespoke Frame Fitting Consultation">Bespoke Frame Fitting Consultation</option>
              <option value="Private Salon Trunk Show">Private Salon Trunk Show</option>
              <option value="Order & Courier Inquiries">Order &amp; Courier Inquiries</option>
              <option value="Press & Optical Architecture">Press &amp; Optical Architecture</option>
            </select>
          </div>
        </div>

        <div style="margin-bottom: 2rem;">
          <label for="ContactFormMessage" style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; margin-bottom: 0.5rem;">
            Message &amp; Optical Notes
          </label>
          <textarea
            rows="5"
            id="ContactFormMessage"
            name="contact[body]"
            placeholder="Please detail your optical questions, frame measurements, or requested consultation date..."
            required
            style="width: 100%; padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem; line-height: 1.6;"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; padding: 1rem;">
          Submit Inquiry to Atelier
        </button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": []
}
{% endschema %}
