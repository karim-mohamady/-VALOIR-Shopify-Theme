<section class="valoir-newsletter-section" style="padding: clamp(3.5rem, 6vw, 6rem) 0; background: #161618; color: #FAF9F6; text-align: center;">
  <div class="valoir-container" style="max-width: 620px;">
    <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.75rem;">
      THE PRIVATE REGISTER
    </span>
    <h2 style="font-size: clamp(1.75rem, 3.5vw, 2.25rem); font-weight: 300; margin-bottom: 1rem; color: #FAF9F6;">
      {{ section.settings.heading | default: "Receive Invitations to Limited Bespoke Releases" }}
    </h2>
    <p style="font-size: 0.9375rem; line-height: 1.6; color: #A8A59E; margin-bottom: 2rem;">
      {{ section.settings.subtext | default: "Members receive priority allocations for numbered 3D-milled titanium silhouettes and private salon trunk shows." }}
    </p>

    {%- form 'customer' -%}
      <div class="valoir-newsletter-form-wrapper">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
          required
          style="flex: 1; padding: 0.875rem 1.25rem; background: #222226; border: 1px solid #333338; color: #FAF9F6; font-size: 0.875rem; border-radius: 2px; outline: none;"
        >
        <button type="submit" class="btn-primary" style="background: #FAF9F6; color: #121214; white-space: nowrap;">
          {{ 'general.newsletter.button_label' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

<style>
  .valoir-newsletter-form-wrapper {
    display: flex;
    gap: 0.5rem;
    max-width: 480px;
    margin: 0 auto;
  }
  @media (max-width: 480px) {
    .valoir-newsletter-form-wrapper {
      flex-direction: column;
      gap: 0.75rem;
    }
    .valoir-newsletter-form-wrapper input,
    .valoir-newsletter-form-wrapper button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Receive Invitations to Limited Bespoke Releases"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Members receive priority allocations for numbered 3D-milled titanium silhouettes and private salon trunk shows."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
