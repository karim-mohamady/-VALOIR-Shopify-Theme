{%- paginate collections by 12 -%}
  <section class="valoir-collections-list-section" style="padding: 4rem 0 6rem;">
    <div class="valoir-container">
      {% render 'breadcrumb' %}

      <header style="text-align: center; margin: 2rem 0 3.5rem;">
        <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          CURATED ARCHIVES
        </span>
        <h1 style="font-family: var(--font-serif); font-size: 3rem; font-weight: 300;">
          All Eyewear Collections
        </h1>
      </header>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
        {%- for collection in collections -%}
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; display: flex; flex-direction: column;">
            <a href="{{ collection.url }}" style="display: block; aspect-ratio: 4 / 3; background: #F4F1EC; overflow: hidden;">
              {%- if collection.featured_image -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                  width="600"
                  height="450"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover;"
                >
              {%- else -%}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); font-size: 0.8125rem;">
                  {{ collection.title }}
                </div>
              {%- endif -%}
            </a>
            <div style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h2 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: 0.25rem;">
                  <a href="{{ collection.url }}" style="color: var(--color-text);">{{ collection.title }}</a>
                </h2>
                <span style="font-size: 0.75rem; color: var(--color-text-muted);">
                  {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'model', 'models' }}
                </span>
              </div>
              <a href="{{ collection.url }}" class="btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.75rem;">
                View
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div style="margin-top: 4rem; display: flex; justify-content: center;">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collections List",
  "settings": []
}
{% endschema %}
