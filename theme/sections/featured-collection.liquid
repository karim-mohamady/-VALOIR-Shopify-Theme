<section class="valoir-featured-collection" style="padding: 5rem 0;">
  <div class="valoir-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <span style="font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          {{ section.settings.subheading | default: "ICONIC SILHOUETTES" }}
        </span>
        <h2 style="font-size: 2.25rem;">{{ section.settings.title | default: "Featured Eyewear" }}</h2>
      </div>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="btn-secondary" style="padding: 0.6rem 1.25rem; font-size: 0.75rem;">
        View Full Archive &rarr;
      </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <!-- Fallback preview cards if collection not set -->
        {%- for i in (1..4) -%}
          <div class="product-card" style="border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface);">
            <div class="product-card-media" style="position: relative; aspect-ratio: 4 / 5; display: flex; align-items: center; justify-content: center; background: #F8F7F4; overflow: hidden;">
              <span class="badge-shape" style="position: absolute; top: 1rem; left: 1rem; z-index: 2; background: rgba(255,255,255,0.92); backdrop-filter: blur(4px); padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.625rem; font-weight: 600; text-transform: uppercase; font-family: var(--font-mono, monospace); border: 1px solid var(--color-border); color: #1A1A1A;">
                {%- case i -%}
                  {%- when 1 -%}Aviator
                  {%- when 2 -%}Geometric Square
                  {%- when 3 -%}Panto Round
                  {%- when 4 -%}Ultra-Thin Titanium
                {%- endcase -%}
              </span>
              {%- case i -%}
                {%- when 1 -%}
                  <img src="{{ 'aero_titanium.jpg' | asset_url }}" alt="Aero-Titanium 01" loading="lazy" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;">
                {%- when 2 -%}
                  <img src="{{ 'grand_palais.jpg' | asset_url }}" alt="Grand Palais 04" loading="lazy" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;">
                {%- when 3 -%}
                  <img src="{{ 'sora_panto.jpg' | asset_url }}" alt="Sora Minimalist 02" loading="lazy" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;">
                {%- when 4 -%}
                  <img src="{{ 'fukui_minimal.jpg' | asset_url }}" alt="Fukui Pure Titanium 05" loading="lazy" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;">
              {%- endcase -%}
            </div>
            <div class="product-card-info" style="padding: 1.25rem 1rem;">
              <span class="product-card-shape" style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.25rem;">
                {%- case i -%}
                  {%- when 1 -%}Sabae Beta-Titanium
                  {%- when 2 -%}Block Acetate 10mm
                  {%- when 3 -%}Vintage Optical
                  {%- when 4 -%}Featherlight 14g
                {%- endcase -%}
              </span>
              <h3 class="product-card-title" style="font-family: var(--font-serif); font-size: 1.125rem; font-weight: 400; color: var(--color-text); margin-bottom: 0.5rem;">
                {%- case i -%}
                  {%- when 1 -%}Aero-Titanium 01
                  {%- when 2 -%}Grand Palais 04
                  {%- when 3 -%}Sora Minimalist 02
                  {%- when 4 -%}Fukui Pure Titanium 05
                {%- endcase -%}
              </h3>
              <div style="font-size: 0.875rem; font-weight: 500; color: var(--color-text);">
                {%- case i -%}
                  {%- when 1 -%}$420.00
                  {%- when 2 -%}$460.00
                  {%- when 3 -%}$390.00
                  {%- when 4 -%}$480.00
                {%- endcase -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "ICONIC SILHOUETTES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Eyewear"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
