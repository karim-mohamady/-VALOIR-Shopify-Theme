<section class="valoir-frame-shapes-section" style="padding: 5rem 0; background-color: #F6F3ED; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="valoir-container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem auto;">
      <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
        OPTICAL CURATION
      </span>
      <h2 style="font-size: 2.25rem; font-weight: 300;">Shop by Frame Architecture</h2>
      <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 0.75rem;">
        Discover silhouettes calibrated to facial geometry and optical focal points.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem;">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '/collections/all' }}" class="frame-shape-card" style="background: var(--color-surface); padding: 1.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border); text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.85rem; transition: transform 250ms ease, border-color 250ms ease;">
          <div style="width: 64px; height: 32px; border: 1.5px solid var(--color-text); border-radius: {% if block.settings.title contains 'Round' %}50%{% elsif block.settings.title contains 'Cat' %}20px 4px{% else %}2px{% endif %}; display: flex; align-items: center; justify-content: center;">
            <div style="width: 8px; height: 1.5px; background: var(--color-text);"></div>
          </div>
          <span style="font-family: var(--font-serif); font-size: 1.125rem; color: var(--color-text);">{{ block.settings.title }}</span>
          <span style="font-size: 0.6875rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em;">{{ block.settings.subtitle }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by Frame Shape",
  "settings": [],
  "blocks": [
    {
      "type": "shape",
      "name": "Frame Shape",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Shape Name",
          "default": "Aviator"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtext",
          "default": "Sculpted Titanium"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Frame Shape",
      "blocks": [
        { "type": "shape", "settings": { "title": "Aviator", "subtitle": "Double Bridge" } },
        { "type": "shape", "settings": { "title": "Geometric Square", "subtitle": "Block Acetate" } },
        { "type": "shape", "settings": { "title": "Panto Round", "subtitle": "Vintage Optical" } },
        { "type": "shape", "settings": { "title": "Cat-Eye Sculpt", "subtitle": "Haute Couture" } },
        { "type": "shape", "settings": { "title": "Ultra-Thin Titanium", "subtitle": "Featherlight" } }
      ]
    }
  ]
}
{% endschema %}
