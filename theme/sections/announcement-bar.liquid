{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    <div class="valoir-container">
      <span>{{ section.settings.text }}</span>
      {%- if section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}">{{ section.settings.link_text }} &rarr;</a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Complimentary Worldwide Express Courier & Precision Prescription Service on orders over $250"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Explore Collection"
    }
  ]
}
{% endschema %}
