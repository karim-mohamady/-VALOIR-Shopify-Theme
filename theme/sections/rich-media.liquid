<section class="valoir-rich-media" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <div class="valoir-container">
    <div style="background: #F3EFE8; border-radius: var(--radius-sm); padding: clamp(2.25rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem); text-align: center; max-width: 900px; margin: 0 auto; border: 1px solid var(--color-border);">
      <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 1rem;">
        ATELIER CALIPER GUARANTEE
      </span>
      <h2 style="font-family: var(--font-serif); font-size: clamp(1.75rem, 3.5vw, 2.25rem); font-weight: 300; margin-bottom: 1.25rem;">
        {{ section.settings.heading | default: "Micro-Caliper Precision & Lifetime Hinge Tuning" | escape }}
      </h2>
      <p style="font-size: 0.9375rem; line-height: 1.7; color: var(--color-text-muted); max-width: 600px; margin: 0 auto 2rem auto;">
        {{ section.settings.description | default: "Every pair includes our complimentary bespoke fit package with hand-calibrated titanium screws, Japanese micro-fiber polishing textile, and lifetime ultrasonic refurbishment at any Valoir partner salon." }}
      </p>
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn-primary">
        {{ section.settings.button_text | default: "Learn About Our Warranty" }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich Media Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Micro-Caliper Precision & Lifetime Hinge Tuning"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Learn About Our Warranty"
    }
  ],
  "presets": [
    {
      "name": "Rich Media Banner"
    }
  ]
}
{% endschema %}
