<section class="valoir-editorial-section" style="padding: clamp(4rem, 7vw, 7rem) 0; background-color: var(--color-bg); position: relative; overflow: hidden;">
  <div class="valoir-container">
    <div class="valoir-editorial-grid">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.35rem 0.75rem; border-radius: 2px; margin-bottom: 1.25rem;">
          <span style="font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600;">
            {{ section.settings.subheading | default: "THE SABAÈ ATELIER" }}
          </span>
        </div>

        <h2 style="font-size: clamp(2rem, 3.8vw, 3rem); line-height: 1.15; font-weight: 300; font-family: var(--font-serif); margin-bottom: 1.5rem; color: var(--color-text);">
          {{ section.settings.heading | default: "One Hundred & Sixty Steps of Optical Mastery" }}
        </h2>

        <div style="font-size: 0.9375rem; line-height: 1.8; color: var(--color-text-muted); display: flex; flex-direction: column; gap: 1rem;">
          <p>
            {{ section.settings.paragraph_1 | default: "Every Valoir frame is born in Sabae, Japan—a legendary enclave where metallurgical masters have honed eyewear manufacturing across three centuries. Over two hundred days are required to cure our natural cotton-based acetate slabs before microscopic CNC routing begins." }}
          </p>
          <p>
            {{ section.settings.paragraph_2 | default: "Temples undergo five consecutive stages of tumbling with organic bamboo chips and walnut husks, achieving a liquid-smooth gloss impossible through chemical baths." }}
          </p>
        </div>

        <!-- Craft Benchmarks Ribbon -->
        <div class="valoir-craft-benchmarks" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.75rem 0.5rem; border-radius: 2px;">
            <span style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 400; color: var(--color-text); display: block;">160</span>
            <span style="font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); display: block; margin-top: 0.25rem;">Steps of Mastery</span>
          </div>
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.75rem 0.5rem; border-radius: 2px;">
            <span style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 400; color: var(--color-text); display: block;">200+</span>
            <span style="font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); display: block; margin-top: 0.25rem;">Days Curing</span>
          </div>
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.75rem 0.5rem; border-radius: 2px;">
            <span style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 400; color: var(--color-text); display: block;">±0.05mm</span>
            <span style="font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); display: block; margin-top: 0.25rem;">CNC Tolerance</span>
          </div>
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.75rem 0.5rem; border-radius: 2px;">
            <span style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 400; color: var(--color-text); display: block;">5</span>
            <span style="font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); display: block; margin-top: 0.25rem;">Bamboo Stages</span>
          </div>
        </div>

        <div style="margin-top: 2rem;">
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn-secondary">
            {{ section.settings.button_text | default: "Read The Atelier Manifesto &rarr;" }}
          </a>
        </div>
      </div>

      <!-- Atelier Visual with Editorial Overlay -->
      <div class="valoir-atelier-image-container" style="position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--color-border); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | default: 'Sabae Master Eyewear Atelier' | escape }}"
            loading="lazy"
            style="width: 100%; height: 100%; object-fit: cover;"
          />
        {%- else -%}
          <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #2D2A26 0%, #151412 100%); display: flex; align-items: center; justify-content: center;">
            <div style="position: absolute; inset: 0; opacity: 0.15; background-image: radial-gradient(#E5B54F 1px, transparent 1px); background-size: 20px 20px;"></div>
          </div>
        {%- endif -%}

        <!-- Top Workshop Stamp -->
        <div style="position: absolute; top: 1rem; left: 1rem; padding: 0.35rem 0.75rem; background: rgba(0,0,0,0.65); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 2px; font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.15em; color: #FAF9F6;">
          Sabae Fukui Atelier • No. 842
        </div>

        <!-- Ambient Dark Gradient -->
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0) 100%);"></div>

        <!-- Bottom Architectural Quote Block -->
        <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: clamp(1.5rem, 3vw, 2.25rem); color: #FAF9F6; z-index: 2;">
          <div style="font-family: var(--font-serif); font-size: clamp(1.25rem, 2.5vw, 1.75rem); line-height: 1.25; font-style: italic; margin-bottom: 0.75rem;">
            {{ section.settings.quote | default: "“Light made architectural.”" }}
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 0.75rem;">
            <span style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em; color: #DFDBD2;">
              {{ section.settings.quote_author | default: "Sabae Fukui Prefecture • Master Artisan Guild" }}
            </span>
            <span style="font-size: 0.6875rem; font-family: monospace; color: var(--color-accent); letter-spacing: 0.1em;">
              ±0.05mm
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .valoir-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 769px) {
    .valoir-editorial-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }
  @media (max-width: 480px) {
    .valoir-craft-benchmarks {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Story",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE SABAÈ ATELIER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One Hundred & Sixty Steps of Optical Mastery"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Every Valoir frame is born in Sabae, Japan—a legendary enclave where metallurgical masters have honed eyewear manufacturing across three centuries. Over two hundred days are required to cure our natural cotton-based acetate slabs before microscopic CNC routing begins."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Temples undergo five consecutive stages of tumbling with organic bamboo chips and walnut husks, achieving a liquid-smooth gloss impossible through chemical baths."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier Image"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "“Light made architectural.”"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "Sabae Fukui Prefecture • Master Artisan Guild"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Read The Atelier Manifesto →"
    }
  ],
  "presets": [
    {
      "name": "Editorial Story"
    }
  ]
}
{% endschema %}
