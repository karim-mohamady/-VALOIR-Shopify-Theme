{% assign cart_image_width = 100 %}
{% assign cart_image_height = 100 %}
<section class="valoir-cart-page" style="padding: clamp(2.5rem, 5vw, 4rem) 0 6rem 0;">
  <div class="valoir-container" style="max-width: 900px;">
    <h1 style="font-size: clamp(2rem, 4vw, 2.5rem); font-weight: 300; margin-bottom: 2rem; text-align: center;">{{ 'sections.cart.title' | t }}</h1>
    {% if cart.item_count == 0 %}
      <div style="text-align:center;padding:4rem 1rem;"><p style="color:var(--color-text-muted);font-size:1.125rem;margin-bottom:2rem;">{{ 'sections.cart.empty' | t }}</p><a href="{{ routes.all_products_collection_url }}" class="btn-primary">{{ 'sections.cart.continue_shopping' | t }}</a></div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        <div style="display:flex;flex-direction:column;gap:1.5rem;margin-bottom:2.5rem;">
          {% for item in cart.items %}
            <div class="valoir-cart-item-row">
              <a href="{{ item.url }}" style="flex-shrink:0;">
                {% if item.image %}{{ item.image | image_url: width: 200 | image_tag: widths: '100,200', sizes: '100px', loading: 'lazy', class: 'valoir-cart-item-img', alt: item.title, width: cart_image_width, height: cart_image_height }}{% endif %}
              </a>
              <div><h2 style="font-family:var(--font-serif);font-size:1.25rem;"><a href="{{ item.url }}" style="color:inherit;text-decoration:none;">{{ item.product.title }}</a></h2>
                {% unless item.variant.title == 'Default Title' %}<p style="font-size:.8125rem;color:var(--color-text-muted);">{{ item.variant.title }}</p>{% endunless %}
                {% if item.original_price != item.final_price %}<div style="font-size:.9375rem;font-weight:500;margin-top:.25rem;"><span style="color:var(--color-sale);">{{ item.final_price | money }}</span> <s style="color:var(--color-text-muted);font-size:.8125rem;">{{ item.original_price | money }}</s></div>{% else %}<div style="font-size:.9375rem;font-weight:500;margin-top:.25rem;">{{ item.final_price | money }}</div>{% endif %}
                {% for discount in item.line_level_discount_allocations %}<div style="font-size:.75rem;color:var(--color-sale);margin-top:.25rem;">{{ discount.discount_application.title }}: -{{ discount.amount | money }}</div>{% endfor %}
              </div>
              <div class="valoir-cart-item-actions"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity' | t }}: {{ item.product.title | escape }}" style="width:60px;padding:.4rem;text-align:center;border:1px solid var(--color-border);border-radius:var(--radius-sm);"><a href="{{ item.url_to_remove }}" style="font-size:.75rem;color:var(--color-text-muted);text-decoration:underline;">{{ 'sections.cart.remove' | t }}</a></div>
            </div>
          {% endfor %}
        </div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:2rem;">
          {% if settings.enable_cart_notes %}<div style="flex:1;min-width:280px;width:100%;"><label for="CartNote" style="font-size:.8125rem;font-weight:600;text-transform:uppercase;display:block;margin-bottom:.5rem;">{{ 'sections.cart.prescription_note' | t }}</label><textarea name="note" id="CartNote" rows="4" placeholder="{{ 'sections.cart.prescription_placeholder' | t }}" style="width:100%;padding:.75rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);font-family:inherit;">{{ cart.note }}</textarea></div>{% endif %}
          <div class="valoir-cart-summary"><div style="font-size:1.25rem;margin-bottom:.5rem;"><span>{{ 'sections.cart.subtotal' | t }}:</span> <strong>{{ cart.total_price | money_with_currency }}</strong></div><p style="font-size:.75rem;color:var(--color-text-muted);margin-bottom:1.5rem;">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p><div style="display:flex;flex-direction:column;gap:.75rem;"><button type="submit" name="checkout" class="btn-primary" style="width:100%;padding:1.125rem;">{{ 'sections.cart.checkout' | t }}</button><button type="submit" name="update" class="btn-secondary" style="width:100%;padding:.875rem;">{{ 'sections.cart.update' | t }}</button></div></div>
        </div>
      </form>
    {% endif %}
  </div>
</section>
<style>.valoir-cart-item-row{display:grid;grid-template-columns:100px 1fr auto;gap:1.5rem;align-items:center;padding-bottom:1.5rem;border-bottom:1px solid var(--color-border)}.valoir-cart-item-img{width:100px;height:100px;object-fit:contain;background:#F4F1EC;border-radius:var(--radius-sm);padding:.5rem}.valoir-cart-item-actions{display:flex;flex-direction:column;align-items:flex-end;gap:.5rem}.valoir-cart-summary{min-width:280px;text-align:end;margin-inline-start:auto}@media(max-width:640px){.valoir-cart-summary{width:100%;text-align:start}}@media(max-width:520px){.valoir-cart-item-row{grid-template-columns:75px 1fr;gap:1rem}.valoir-cart-item-img{width:75px;height:75px}.valoir-cart-item-actions{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center}}</style>
{% schema %}{"name":"Cart Page","settings":[]}{% endschema %}
