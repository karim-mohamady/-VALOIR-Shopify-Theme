<section class="valoir-product-showcase" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <div class="valoir-container">
    {%- assign featured_product = section.settings.product -%}
    <div class="valoir-product-showcase-grid">
      <div style="aspect-ratio: 1 / 1; background: #F4F1EC; border-radius: var(--radius-sm); overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
        {%- if featured_product.featured_media != blank -%}
          {{ featured_product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: featured_product.title, style: 'width: 100%; height: 100%; object-fit: cover;' }}
        {%- else -%}
          <img
            src="{{ 'solarium_haute.jpg' | asset_url }}"
            alt="Solarium Haute Couture Eyewear"
            loading="lazy"
            width="900"
            height="900"
            style="width: 100%; height: 100%; object-fit: cover;"
          >
        {%- endif -%}
      </div>
      <div>
        <span style="font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          {{ 'products.product.vendor' | t | default: 'PRODUCT SPOTLIGHT' }}
        </span>
        <h2 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 300; line-height: 1.2; margin-bottom: 1.25rem;">
          {{ featured_product.title | default: "Architectural Silhouette" }}
        </h2>
        {%- if featured_product != blank -%}
          <div style="font-size: 1.25rem; font-weight: 500; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
            <span>{{ featured_product.price | money }}</span>
            {%- if featured_product.compare_at_price > featured_product.price -%}
              <span style="text-decoration: line-through; color: var(--color-text-muted); font-size: 1rem;">
                {{ featured_product.compare_at_price | money }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
        <p style="font-size: 0.9375rem; line-height: 1.7; color: var(--color-text-muted); margin-bottom: 2rem;">
          {%- if featured_product.description != blank -%}
            {{ featured_product.description | strip_html | truncatewords: 30 }}
          {%- else -%}
            Milled from aerospace-grade Japanese titanium with hand-filed bridge chamfers, integrated saddle bridge, and scratch-resistant optics.
          {%- endif -%}
        </p>
        <a href="{{ featured_product.url | default: routes.all_products_collection_url }}" class="btn-primary">
          {{ 'products.product.view' | t | default: 'View Specifications' }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .valoir-product-showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 769px) {
    .valoir-product-showcase-grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }
</style>

{% schema %}
{
  "name": "Product Spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight"
    }
  ]
}
{% endschema %}
