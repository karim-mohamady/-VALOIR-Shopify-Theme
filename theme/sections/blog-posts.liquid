<section class="valoir-journal-section" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <div class="valoir-container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: clamp(1.75rem, 3vw, 2.5rem); flex-wrap: wrap; gap: 1rem;">
      <div>
        <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          CHRONICLES
        </span>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 300;">The Atelier Journal</h2>
      </div>
      <a href="{{ section.settings.blog.url | default: routes.root_url }}" class="btn-secondary" style="padding: 0.6rem 1.25rem; font-size: 0.75rem;">Read All Entries &rarr;</a>
    </div>

    <div class="valoir-journal-grid">
      {%- for article in section.settings.blog.articles limit: 3 -%}
        <article>
          <div style="aspect-ratio: 16 / 10; background: #ECE8E0; border-radius: var(--radius-sm); margin-bottom: 1rem; overflow: hidden;">
            {%- if article.image != blank -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title, style: 'width: 100%; height: 100%; object-fit: cover;' }}
            {%- endif -%}
          </div>
          <span style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted);">{{ article.published_at | date: "%B %d, %Y" }}</span>
          <h3 style="font-family: var(--font-serif); font-size: 1.25rem; margin-top: 0.25rem; line-height: 1.3;">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h3>
        </article>
      {%- else -%}
        {%- for i in (1..3) -%}
          <article>
            <div style="aspect-ratio: 16 / 10; background: #ECE8E0; border-radius: var(--radius-sm); margin-bottom: 1rem; overflow: hidden; display: flex; align-items: center; justify-content: center;">
              {{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <span style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted);">{{ 'now' | date: "%B %Y" }}</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; margin-top: 0.25rem;">
              {{ 'sections.featured_blog.onboarding_title' | t | default: 'Atelier Metallurgy & Architectural Optics' }}
            </h3>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .valoir-journal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .valoir-journal-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }
  @media (min-width: 1024px) {
    .valoir-journal-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Blog Posts",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "Blog Posts"
    }
  ]
}
{% endschema %}
