{%- paginate blog.articles by section.settings.articles_per_page -%}
  <section class="valoir-blog-section" style="padding: 4rem 0 6rem;">
    <div class="valoir-container">
      {% render 'breadcrumb' %}

      <header style="text-align: center; margin: 2rem 0 3.5rem;">
        <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          CHRONICLES &amp; OPTICAL CRAFT
        </span>
        <h1 style="font-family: var(--font-serif); font-size: 3rem; font-weight: 300;">
          {{ blog.title }}
        </h1>
      </header>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem;">
        {%- for article in blog.articles -%}
          <article style="display: flex; flex-direction: column;">
            <a href="{{ article.url }}" style="display: block; aspect-ratio: 16 / 10; background: #ECE8E0; border-radius: var(--radius-sm); margin-bottom: 1.25rem; overflow: hidden;">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 640 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="640"
                  height="400"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                >
              {%- endif -%}
            </a>
            <div style="font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 0.5rem;">
              {{ article.published_at | date: format: 'date' }}
            </div>
            <h2 style="font-family: var(--font-serif); font-size: 1.375rem; line-height: 1.3; margin-bottom: 0.75rem;">
              <a href="{{ article.url }}" style="color: var(--color-text);">{{ article.title }}</a>
            </h2>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1.25rem; flex: 1;">
              {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
            </p>
            <a href="{{ article.url }}" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: inline-flex; align-items: center; gap: 0.25rem;">
              Read Entry &rarr;
            </a>
          </article>
        {%- else -%}
          <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem;">
            <p style="color: var(--color-text-muted);">No entries recorded in this atelier chronicle yet.</p>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div style="margin-top: 4rem; display: flex; justify-content: center; gap: 0.5rem;">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Grid",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 18,
      "step": 3,
      "default": 9,
      "label": "Articles per page"
    }
  ]
}
{% endschema %}
