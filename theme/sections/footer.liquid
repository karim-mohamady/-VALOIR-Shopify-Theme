{%- assign footer_menu = linklists[section.settings.menu] -%}
{%- assign care_menu = linklists[section.settings.care_menu] -%}
<footer class="site-footer" role="contentinfo"><div class="valoir-container"><div class="footer-grid"><div><h3 class="header-logo">{{ shop.name | escape }}</h3><p>{{ 'sections.footer.brand_story' | t }}</p></div><div><h4 class="footer-heading">{{ 'sections.footer.quick_links' | t }}</h4><ul class="footer-links">{%- if footer_menu != blank -%}{%- for link in footer_menu.links -%}<li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>{%- endfor -%}{%- endif -%}</ul></div><div><h4 class="footer-heading">{{ 'sections.footer.customer_care' | t }}</h4><ul class="footer-links">{%- if care_menu != blank -%}{%- for link in care_menu.links -%}<li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>{%- endfor -%}{%- endif -%}</ul></div><div><h4 class="footer-heading">{{ 'general.newsletter.heading' | t }}</h4><p>{{ 'general.newsletter.subtext' | t }}</p>{%- form 'customer', class: 'footer-newsletter-form' -%}<label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.email_placeholder' | t }}</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" required><button type="submit" class="btn-primary" aria-label="{{ 'general.newsletter.submit' | t }}">{{ 'general.newsletter.submit' | t }}</button>{%- endform -%}{%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}<div class="footer__follow-on-shop">{{ shop | login_button: action: 'follow' }}</div>{%- endif -%}</div></div>{%- if section.settings.enable_country_selector or section.settings.enable_language_selector or section.settings.show_payment_icons -%}<div class="footer-localization">{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}{%- form 'localization', id: 'FooterLocalizationForm', class: 'localization-form' -%}<div>{%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}<label for="FooterCountrySelect" class="visually-hidden">{{ 'localization.country_label' | t }}</label><select name="country_code" id="FooterCountrySelect" onchange="this.form.submit()">{%- for country in localization.available_countries -%}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{%- endfor -%}</select>{%- endif -%}{%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}<label for="FooterLanguageSelect" class="visually-hidden">{{ 'localization.language_label' | t }}</label><select name="language_code" id="FooterLanguageSelect" onchange="this.form.submit()">{%- for language in localization.available_languages -%}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>{%- endfor -%}</select>{%- endif -%}<noscript><button type="submit" class="btn-secondary">{{ 'localization.submit' | t }}</button></noscript></div>{%- endform -%}{%- endif -%}{%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}<div class="footer-payment-icons">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}{%- endfor -%}</div>{%- endif -%}</div>{%- endif -%}<div class="footer-bottom"><div>{{ 'sections.footer.copyright' | t }}</div>{%- if shop.policies.size > 0 -%}<div class="footer-policies">{%- for policy in shop.policies -%}{%- if policy.url != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}{%- endfor -%}</div>{%- endif -%}<div>{{ 'sections.footer.powered_by' | t }}</div></div></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu","default":"footer"},{"type":"link_list","id":"care_menu","label":"Customer care menu"},{"type":"checkbox","id":"enable_country_selector","label":"Enable Country/Region Selector","default":true},{"type":"checkbox","id":"enable_language_selector","label":"Enable Language Selector","default":true},{"type":"checkbox","id":"enable_follow_on_shop","label":"Enable Follow on Shop","default":true},{"type":"checkbox","id":"show_payment_icons","label":"Show Payment Icons","default":true}]}{% endschema %}
