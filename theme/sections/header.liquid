{%- assign menu = linklists[section.settings.menu] -%}<header class="site-header" role="banner"><div class="valoir-container"><div class="header-inner"><button type="button" class="header-icon-btn mobile-only" data-drawer-trigger="mobile-nav-drawer" aria-controls="mobile-nav-drawer" aria-expanded="false" aria-label="{{ 'accessibility.open_menu' | t }}">{% render 'icon', name: 'menu' %}</button><a href="{{ routes.root_url }}" class="header-logo">{% if section.settings.logo != blank %}<img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name | escape }}" width="160" height="40" loading="eager" fetchpriority="high">{% else %}{{ section.settings.logo_text | default: 'VALOIR' | escape }}{% endif %}</a><nav class="nav-desktop-wrapper" aria-label="{{ 'sections.header.navigation' | t }}"><ul class="nav-desktop">{% if menu != blank and menu.links.size > 0 %}{% for link in menu.links %}<li class="nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}{% else %}<li class="nav-item"><a href="{{ routes.all_products_collection_url }}">{{ 'sections.header.optical' | t }}</a></li><li class="nav-item"><a href="{{ routes.all_products_collection_url }}">{{ 'sections.header.sunglasses' | t }}</a></li>{% endif %}</ul></nav><div class="header-icons"><a href="{{ routes.search_url }}" class="header-icon-btn" aria-label="{{ 'sections.header.search_toggle' | t }}">{% render 'icon', name: 'search' %}</a>{% if shop.customer_accounts_enabled %}<div class="header-account-wrapper"><shopify-account></shopify-account><noscript><a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="{{ 'sections.header.account' | t }}">{% render 'icon', name: 'account' %}</a></noscript></div>{% endif %}<button type="button" class="header-icon-btn" data-drawer-trigger="cart-drawer-container" aria-controls="cart-drawer-container" aria-expanded="false" aria-label="{{ 'accessibility.view_cart' | t: count: cart.item_count }}">{% render 'icon', name: 'cart' %}<span class="cart-count-badge" style="{% if cart.item_count == 0 %}display:none;{% endif %}">{{ cart.item_count }}</span></button></div></div></div></header><div id="mobile-nav-drawer" class="mobile-nav-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="mobile-nav-title"><div class="drawer-overlay" data-action="close-drawer"></div><div class="mobile-nav-panel"><div class="drawer-header"><h2 id="mobile-nav-title" class="font-serif">{{ section.settings.logo_text | default: 'VALOIR' | escape }}</h2><button type="button" data-action="close-drawer" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button></div><ul class="mobile-nav-list">{% if menu != blank and menu.links.size > 0 %}{% for link in menu.links %}<li class="mobile-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}{% else %}<li class="mobile-nav-item"><a href="{{ routes.all_products_collection_url }}">{{ 'sections.header.optical' | t }}</a></li><li class="mobile-nav-item"><a href="{{ routes.all_products_collection_url }}">{{ 'sections.header.sunglasses' | t }}</a></li>{% endif %}</ul></div></div>{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo Image"},{"type":"text","id":"logo_text","label":"Logo Text","default":"VALOIR"},{"type":"link_list","id":"menu","label":"Main Menu","default":"main-menu"}]}{% endschema %}
