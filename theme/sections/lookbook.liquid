<section class="valoir-lookbook-section" style="padding: clamp(3rem, 6vw, 5rem) 0; background: var(--color-bg);" data-section-id="{{ section.id }}">
  <div class="valoir-container">
    <div style="text-align: center; margin-bottom: clamp(2rem, 4vw, 3.5rem);">
      {%- if section.settings.subheading != blank -%}
        <span style="font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; display: block; margin-bottom: 0.5rem;">
          {{ section.settings.subheading | escape }}
        </span>
      {%- endif -%}
      <h2 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 300; font-family: var(--font-serif); margin: 0;">
        {{ section.settings.heading | default: "Editorial Lookbook" | escape }}
      </h2>
    </div>

    <div class="valoir-lookbook-grid">
      {%- for block in section.blocks -%}
        <div class="valoir-lookbook-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title, style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;' }}
          {%- else -%}
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0.25;">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 60%, transparent 100%); pointer-events: none;"></div>
          <div style="position: relative; z-index: 2;">
            <h3 style="font-family: var(--font-serif); font-size: 1.5rem; color: #FAF9F6; margin-bottom: 0.25rem;">{{ block.settings.title | escape }}</h3>
            <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #DDD; margin: 0;">{{ block.settings.subtitle | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .valoir-lookbook-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .valoir-lookbook-card {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #202024;
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: #FAF9F6;
  }
  @media (min-width: 640px) {
    .valoir-lookbook-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .valoir-lookbook-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "VOLUME VIII"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Editorial Lookbook"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Look Title",
          "default": "Autumn Vernacular"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Model: Titanium Silhouette 02"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Look Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Lookbook",
      "blocks": [
        { "type": "look", "settings": { "title": "Sora Minimalist", "subtitle": "Ultra-thin Titanium 01" } },
        { "type": "look", "settings": { "title": "Palais Solarium", "subtitle": "Block Acetate 04" } },
        { "type": "look", "settings": { "title": "Kyoto Geometry", "subtitle": "Panto Double Bridge" } }
      ]
    }
  ]
}
{% endschema %}
