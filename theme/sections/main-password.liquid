<section class="password-content" style="max-width: 540px; width: 100%; text-align: center; background: var(--color-surface); padding: 3.5rem 2rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);">
  <h1 class="header-logo" style="font-size: 2.25rem; letter-spacing: 0.15em; margin-bottom: 0.5rem;">
    {{ shop.name }}
  </h1>
  <p style="font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 600; margin-bottom: 2rem;">
    HAUTE LUNETTERIE & OPTICAL ARCHITECTURE
  </p>

  <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 300; margin-bottom: 1rem; line-height: 1.3;">
    {{ section.settings.heading | default: 'Opening Soon • Private Atelier Access' }}
  </h2>

  {%- if shop.password_message != blank -%}
    <p style="color: var(--color-text-muted); font-size: 0.875rem; margin-bottom: 2rem; line-height: 1.6;">
      {{ shop.password_message }}
    </p>
  {%- else -%}
    <p style="color: var(--color-text-muted); font-size: 0.875rem; margin-bottom: 2rem; line-height: 1.6;">
      {{ section.settings.subtext | default: 'Be the first to explore the 2026 Titanium & Hand-Cut Acetate collection.' }}
    </p>
  {%- endif -%}

  {%- form 'customer', class: 'password-newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, password_page">
    <div style="display: flex; gap: 0.5rem; max-width: 400px; margin: 0 auto 2.5rem;">
      <label for="PasswordNewsletterEmail" class="visually-hidden">{{ 'general.newsletter.email_placeholder' | t | default: 'Email address' }}</label>
      <input
        type="email"
        name="contact[email]"
        id="PasswordNewsletterEmail"
        placeholder="{{ 'general.newsletter.email_placeholder' | t | default: 'Enter your email' }}"
        required
        style="flex: 1; padding: 0.875rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.875rem;"
      >
      <button type="submit" class="btn-primary" style="padding: 0.875rem 1.25rem;">
        {{ 'general.newsletter.submit' | t | default: 'Notify Me' }}
      </button>
    </div>
  {%- endform -%}

  <div style="border-top: 1px solid var(--color-border); padding-top: 2rem; margin-top: 1rem;">
    <p style="font-size: 0.75rem; color: var(--color-text-muted); margin-bottom: 1rem;">
      Store administrator or salon client?
    </p>
    {%- form 'storefront_password', class: 'password-login-form' -%}
      {%- if form.errors -%}
        <div role="alert" style="color: #B00020; font-size: 0.8125rem; margin-bottom: 0.75rem;">
          {{ form.errors.messages['form'] }}
        </div>
      {%- endif -%}
      <div style="display: flex; gap: 0.5rem; max-width: 320px; margin: 0 auto;">
        <label for="StorefrontPassword" class="visually-hidden">Password</label>
        <input
          type="password"
          name="password"
          id="StorefrontPassword"
          placeholder="Atelier Password"
          required
          style="flex: 1; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 0.8125rem;"
        >
        <button type="submit" class="btn-secondary" style="padding: 0.75rem 1rem; font-size: 0.75rem;">
          Enter
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening Soon • Private Atelier Access"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Be the first to explore the 2026 Titanium & Hand-Cut Acetate collection."
    }
  ]
}
{% endschema %}
