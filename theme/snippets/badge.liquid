{% comment %}
  Renders product badges (Sale, Sold Out, Frame Shape)
  Usage: {% render 'badge', type: 'sale' %}
{% endcomment %}
{%- case type -%}
  {%- when 'sale' -%}
    <span class="badge-sale">
      {{ 'products.product.sale_price' | t }}
    </span>
  {%- when 'sold_out' -%}
    <span class="badge-shape" style="background: #E5E2DC;">
      {{ 'products.product.sold_out' | t }}
    </span>
  {%- when 'shape' -%}
    {%- if shape != blank -%}
      <span class="badge-shape">
        {{ shape }}
      </span>
    {%- endif -%}
{%- endcase -%}
