{%- comment -%}
  Renders localized checkout route data safely for client-side scripts.
{%- endcomment -%}
{%- assign checkout_route_prefix = routes.root_url -%}
{%- unless checkout_route_prefix == '/' -%}
  {%- assign checkout_route_prefix = checkout_route_prefix | append: '/' -%}
{%- endunless -%}
{%- assign checkout_route_prefix = checkout_route_prefix | replace: '//', '/' -%}
{%- assign checkout_destination = checkout_route_prefix | append: 'checkout' -%}

<script>
  window.Valoir = window.Valoir || {};
  window.Valoir.routes = window.Valoir.routes || {};
  window.Valoir.routes.checkout_url = {{ checkout_destination | json }};
</script>
