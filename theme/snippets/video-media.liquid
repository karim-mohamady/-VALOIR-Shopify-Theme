{% comment %}
  Renders product video or external YouTube/Vimeo video
{% endcomment %}
{%- if media.media_type == 'video' -%}
  {{ media | video_tag: controls: true, autoplay: false, loop: true, class: 'product-media-video' }}
{%- elsif media.media_type == 'external_video' -%}
  {{ media | external_video_tag: class: 'product-media-video' }}
{%- endif -%}
