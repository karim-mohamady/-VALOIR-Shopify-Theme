{% comment %}
  Renders breadcrumbs navigation
  Usage: {% render 'breadcrumb' %}
{% endcomment %}
<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="font-size: 0.75rem; color: var(--color-text-muted); padding: 1.25rem 0;">
  <ol style="list-style: none; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
    <li><a href="{{ routes.root_url }}" style="color: var(--color-text-muted);">{{ 'general.home' | t | default: 'Home' }}</a></li>
    <li aria-hidden="true">/</li>
    {%- if template contains 'collection' -%}
      <li aria-current="page" style="color: var(--color-text); font-weight: 500;">{{ collection.title }}</li>
    {%- elsif template contains 'product' -%}
      {%- if collection -%}
        <li><a href="{{ collection.url }}" style="color: var(--color-text-muted);">{{ collection.title }}</a></li>
        <li aria-hidden="true">/</li>
      {%- endif -%}
      <li aria-current="page" style="color: var(--color-text); font-weight: 500;">{{ product.title }}</li>
    {%- elsif template contains 'article' -%}
      <li><a href="{{ blog.url }}" style="color: var(--color-text-muted);">{{ blog.title }}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" style="color: var(--color-text); font-weight: 500;">{{ article.title }}</li>
    {%- elsif template contains 'blog' -%}
      <li aria-current="page" style="color: var(--color-text); font-weight: 500;">{{ blog.title }}</li>
    {%- else -%}
      <li aria-current="page" style="color: var(--color-text); font-weight: 500;">{{ page_title }}</li>
    {%- endif -%}
  </ol>
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.home' | t | default: 'Home' | json }},
      "item": {{ shop.url | append: routes.root_url | json }}
    }
    {%- if template contains 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
    {%- elsif template contains 'product' -%}
      {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ canonical_url | json }}
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ canonical_url | json }}
        }
      {%- endif -%}
    {%- elsif template contains 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ shop.url | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ canonical_url | json }}
      }
    {%- elsif template contains 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ shop.url | append: blog.url | json }}
      }
    {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page_title | json }},
        "item": {{ canonical_url | json }}
      }
    {%- endif -%}
  ]
}
</script>
