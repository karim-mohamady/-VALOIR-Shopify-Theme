{% assign checkout_route = routes.root_url | append: 'checkout' | replace: '//', '/' %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or settings.force_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
    {% render 'seo-meta' %}
    {% style %}
      {% if settings.font_heading != blank %}{{ settings.font_heading | font_face: font_display: 'swap' }}{% endif %}
      {% if settings.font_body != blank %}{{ settings.font_body | font_face: font_display: 'swap' }}{% endif %}
      :root { --color-bg: {{ settings.color_bg | default: '#FAF9F6' }}; --color-surface: {{ settings.color_surface | default: '#FFFFFF' }}; --color-text: {{ settings.color_text | default: '#1A1A1A' }}; --color-text-muted: {{ settings.color_text_muted | default: '#6B6864' }}; --color-accent: {{ settings.color_accent | default: '#C29B38' }}; --color-border: {{ settings.color_border | default: '#E5E2DC' }}; --color-sale: {{ settings.color_sale | default: '#8B261E' }}; --font-heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }}; --font-body-scale: {{ settings.body_scale | default: 100 | divided_by: 100.0 }}; --page-width: {{ settings.page_width | default: 1440 }}px; --card-aspect-ratio: {{ settings.card_aspect_ratio | default: '4/5' }}; }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'accessibility.css' | asset_url | stylesheet_tag }}
    {{ 'component-header.css' | asset_url | stylesheet_tag }}
    {{ 'component-footer.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'component-modal.css' | asset_url | stylesheet_tag }}
    {% if template contains 'product' %}{{ 'component-product.css' | asset_url | stylesheet_tag }}{{ 'component-media-gallery.css' | asset_url | stylesheet_tag }}{{ 'component-3d-viewer.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if template contains 'cart' %}{{ 'component-cart.css' | asset_url | stylesheet_tag }}{% endif %}
    {% if template contains 'search' %}{{ 'component-search.css' | asset_url | stylesheet_tag }}{% endif %}
    {{ content_for_header }}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Valoir = {
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }}, adding: {{ 'products.product.adding' | t | json }}, soldOut: {{ 'products.product.sold_out' | t | json }}, unavailable: {{ 'products.product.unavailable' | t | json }}, cartEmpty: {{ 'sections.cart.empty' | t | json }}, remove: {{ 'sections.cart.remove' | t | json }}, update: {{ 'sections.cart.update' | t | json }}, subtotal: {{ 'sections.cart.subtotal' | t | json }}, checkout: {{ 'sections.cart.checkout' | t | json }}, continueShopping: {{ 'sections.cart.continue_shopping' | t | json }}, discounts: {{ 'sections.cart.discounts' | t | json }}, itemAdded: {{ 'sections.cart.item_added' | t | json }}, cartError: {{ 'sections.cart.cart_error' | t | json }}, taxesAndShipping: {{ 'sections.cart.taxes_and_shipping_at_checkout' | t | json }}, freeShippingReached: {{ 'sections.cart.free_shipping_reached' | t | json }}, freeShippingRemaining: {{ 'sections.cart.free_shipping_remaining' | t | json }}, prescriptionNote: {{ 'sections.cart.prescription_note' | t | json }}, prescriptionPlaceholder: {{ 'sections.cart.prescription_placeholder' | t | json }}, quantity: {{ 'products.product.quantity' | t | json }}, decreaseQuantity: {{ 'accessibility.decrease_quantity' | t | json }}, increaseQuantity: {{ 'accessibility.increase_quantity' | t | json }}, updated: {{ 'sections.cart.updated' | t | json }}, view3D: {{ 'sections.eyewear_explorer.view_3d' | t | json }}, rotateInstructions: {{ 'sections.eyewear_explorer.instructions' | t | json }}, resetView: {{ 'sections.eyewear_explorer.reset' | t | json }}, pauseRotate: {{ 'sections.eyewear_explorer.pause' | t | json }}, playRotate: {{ 'sections.eyewear_explorer.play' | t | json }}, zoomIn: {{ 'sections.eyewear_explorer.zoom_in' | t | json }}, zoomOut: {{ 'sections.eyewear_explorer.zoom_out' | t | json }}, rotateModel: {{ 'accessibility.rotate_model' | t | json }}, viewInAR: {{ 'products.product.view_in_ar' | t | json }}, arDeviceNotice: {{ 'sections.eyewear_explorer.ar_device_notice' | t | json }}, arIosNotice: {{ 'sections.eyewear_explorer.ar_ios_notice' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }}, freeShippingThreshold: {{ settings.free_shipping_threshold | default: 250 | json }}, enableCartNotes: {{ settings.enable_cart_notes | default: true | json }},
        routes: { cart_add_url: {{ routes.cart_add_url | json }}, cart_change_url: {{ routes.cart_change_url | json }}, cart_update_url: {{ routes.cart_update_url | json }}, cart_url: {{ routes.cart_url | json }}, checkout_url: {{ checkout_route | json }}, predictive_search_url: {{ routes.predictive_search_url | json }}, all_products_collection_url: {{ routes.all_products_collection_url | json }} }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script><script src="{{ 'cart.js' | asset_url }}" defer></script><script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
    {% if template contains 'product' %}<script src="{{ 'media-gallery.js' | asset_url }}" defer></script><script src="{{ 'variant-picker.js' | asset_url }}" defer></script><script src="{{ 'product.js' | asset_url }}" defer></script>{% endif %}
    {% if template contains 'product' or template == 'index' %}<script src="{{ '3d-viewer.js' | asset_url }}" defer></script>{% endif %}
  </head>
  <body class="template-{{ template.name | handle }} valoir-body" data-money-format="{{ shop.money_format }}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {% sections 'header-group' %}<main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">{{ content_for_layout }}</main>{% sections 'footer-group' %}
    <div id="cart-drawer-container" class="drawer-container" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title"><div class="drawer-overlay" data-action="close-drawer"></div><div class="drawer-panel drawer-right"><div class="drawer-header"><h2 id="cart-drawer-title" class="drawer-title font-serif">{{ 'sections.cart.title' | t }}</h2><button type="button" class="drawer-close" data-action="close-drawer" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div id="cart-drawer-body" class="drawer-body"></div></div></div>
    <div id="valoir-3d-modal" class="valoir-modal" aria-hidden="true" role="dialog" aria-modal="true"><div class="modal-overlay" data-action="close-modal"></div><div class="modal-content modal-3d-content"><button type="button" class="modal-close" data-action="close-modal" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button><div id="valoir-3d-modal-viewport" class="modal-3d-viewport"></div></div></div>
    <div id="valoir-a11y-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
