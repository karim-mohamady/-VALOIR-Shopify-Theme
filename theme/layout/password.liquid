<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code contains 'ar-' or settings.force_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF9F6">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'seo-meta' %}

    {{ content_for_header }}

    <!-- Typography & Dynamic Theme Variables via Shopify Settings -->
    {%- style -%}
      {%- if settings.font_heading != blank -%}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
        {%- assign font_heading_bold = settings.font_heading | font_modify: 'weight', 'bolder' -%}
        {%- if font_heading_bold -%}
          {{ font_heading_bold | font_face: font_display: 'swap' }}
        {%- endif -%}
      {%- endif -%}

      {%- if settings.font_body != blank -%}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {%- assign font_body_bold = settings.font_body | font_modify: 'weight', 'bolder' -%}
        {%- if font_body_bold -%}
          {{ font_body_bold | font_face: font_display: 'swap' }}
        {%- endif -%}
      {%- endif -%}

      :root {
        --color-bg: {{ settings.color_bg | default: '#FAF9F6' }};
        --color-background: {{ settings.color_bg | default: '#FAF9F6' }};
        --color-surface: {{ settings.color_surface | default: '#FFFFFF' }};
        --color-text: {{ settings.color_text | default: '#1A1A1A' }};
        --color-text-muted: {{ settings.color_text_muted | default: '#6B6864' }};
        --color-accent: {{ settings.color_accent | default: '#C29B38' }};
        --color-border: {{ settings.color_border | default: '#E5E2DC' }};
        --color-sale: {{ settings.color_sale | default: '#8B261E' }};

        {%- if settings.font_heading != blank -%}
          --font-serif: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
          --font-serif-weight: {{ settings.font_heading.weight }};
          --font-serif-style: {{ settings.font_heading.style }};
        {%- else -%}
          --font-serif: 'Cormorant Garamond', Georgia, serif;
          --font-serif-weight: 400;
          --font-serif-style: normal;
        {%- endif -%}

        {%- if settings.font_body != blank -%}
          --font-sans: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
          --font-sans-weight: {{ settings.font_body.weight }};
          --font-sans-style: {{ settings.font_body.style }};
        {%- else -%}
          --font-sans: 'Assistant', -apple-system, BlinkMacSystemFont, sans-serif;
          --font-sans-weight: 400;
          --font-sans-style: normal;
        {%- endif -%}

        --font-heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
        --font-body-scale: {{ settings.body_scale | default: 100 | divided_by: 100.0 }};

        --page-width: {{ settings.page_width | default: 1440 }}px;
      }
    {%- endstyle -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'accessibility.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="password-template-body" style="background-color: var(--color-background); min-height: 100vh; display: flex; flex-direction: column;">
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t | default: 'Skip to content' }}
    </a>

    <main id="MainContent" class="password-main" role="main" style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem;">
      {{ content_for_layout }}
    </main>
  </body>
</html>
